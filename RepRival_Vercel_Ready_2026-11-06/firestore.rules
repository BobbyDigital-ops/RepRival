rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Only the explicit owner email can be bootstrapped as admin
    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'zebob85@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Validate UserProfile document
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.username is string && data.username.size() <= 60 &&
             data.role in ['admin', 'athlete'];
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      // Only owner or admin can create profile. Non-admins CANNOT assign role: 'admin'
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(request.resource.data) &&
        (isBootstrappedAdmin() || request.resource.data.role == 'athlete');

      // On update, users cannot escalate their own role
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && isValidUserProfile(request.resource.data) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.uid == resource.data.uid)
      );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Workouts subcollection
      match /workouts/{workoutId} {
        allow get, list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(workoutId) && (isOwner(userId) || isAdmin()) &&
                         request.resource.data.userId == userId;
        allow update: if isValidId(userId) && isValidId(workoutId) && (isOwner(userId) || isAdmin()) &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isValidId(userId) && isValidId(workoutId) && (isOwner(userId) || isAdmin());
      }
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn();
      allow list: if isAdmin();
      allow write: if isValidId(adminId) && isBootstrappedAdmin();
    }
  }
}
